{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@AppStage/*": ["src/components/features/AppStage/*"],
      "@GameStage/*": ["src/components/features/AppStage/GameStage/*"],
      "@UiTestStage/*": ["src/components/features/AppStage/UiTestStage/*"],
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@engine/*": ["src/engine/*"],
      "@features/*": ["src/components/features/*"],
      "@store/*": ["src/store/*"],
      "@svg/*": ["src/assets/svg/*"],
      "@ui/*": ["src/components/ui/*"],
      "@util/*": ["src/util/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"]
  }
}

